# TossIQ & Toss Analytics Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (SQLite default, PostgreSQL-ready)
# For SQLite: sqlite+aiosqlite:///./toss_analytics.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/toss_analytics
DATABASE_URL=sqlite+aiosqlite:///./toss_analytics.db
SYNC_DATABASE_URL=sqlite:///./toss_analytics.db

# Timezone
APP_TIMEZONE=Asia/Kolkata

# Admin Credentials (Set strong credentials in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_admin_password
SECRET_KEY=change_this_to_a_random_secret_key_at_least_32_chars

# External Collectors / Integrations (Optional)
# Gaming Helper Online
GAMING_HELPER_PHONE=
GAMING_HELPER_PASSWORD=
GAMING_HELPER_ENABLED=false

# Telegram Telethon Client (Optional for tracking tipster channels)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_CHANNELS=
TELEGRAM_ENABLED=false

# Polling & Automation Intervals (seconds)
MATCH_POLL_INTERVAL=300
TOSS_POLL_INTERVAL=60

# Statistical Thresholds
MIN_HISTORICAL_SAMPLE_SIZE=30
SIGNIFICANCE_ALPHA=0.05
