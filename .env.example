# ==============================================================================
# Toss Analytics & Tracking Admin Panel Configuration Template
# Placeholders only. Copy to .env and provide real credentials. Never commit .env!
# ==============================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (SQLite default, PostgreSQL-ready)
# For SQLite: sqlite+aiosqlite:///./toss_analytics.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/toss_analytics
DATABASE_URL=sqlite+aiosqlite:///./toss_analytics.db
SYNC_DATABASE_URL=sqlite:///./toss_analytics.db

# Timezone (Stored UTC, displayed in target timezone)
APP_TIMEZONE=Asia/Kolkata

# Admin Authentication & Session
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password
SECRET_KEY=generate_random_secret_key_at_least_32_characters
SESSION_EXPIRE_MINUTES=120
SESSION_COOKIE_SECURE=false
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_SECONDS=900

# GamingHelper Online Ingestion Config
GAMING_HELPER_BASE_URL=https://gaminglive.gaminghelperonline.com/api
GAMING_HELPER_LOGIN_URL=https://gaminglive.gaminghelperonline.com/api/users/login
GAMING_HELPER_LIVE_URL=https://gaminglive.gaminghelperonline.com/api/live-bet
GAMING_HELPER_PHONE=
GAMING_HELPER_PASSWORD=
GAMING_HELPER_ENABLED=false

# Telegram Telethon & Channel Config
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_URL=https://t.me/s/KINGTOSSLINE111
TELEGRAM_CHANNELS=@KINGTOSSLINE111
TELEGRAM_ENABLED=false

# Scheduled Polling & Intervals (in seconds)
MATCH_POLL_INTERVAL=300
TOSS_POLL_INTERVAL=60
GAMING_HELPER_POLL_INTERVAL=90
FIXTURES_POLL_INTERVAL=300
SOURCES_POLL_INTERVAL=300
CRICSHEET_SYNC_INTERVAL_HOURS=24
HEALTH_CHECK_INTERVAL=300

# Automated Database Backups
BACKUP_DIR=_backups
BACKUP_KEEP_COUNT=7
BACKUP_INTERVAL_HOURS=24

# Statistical Honesty & Significance Thresholds
MIN_SAMPLE=30
CONFIDENCE=0.95
SIGNIFICANCE_ALPHA=0.05
