# ==============================================================================
# TossIQ - Local Cricket Toss Intelligence Platform Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local SQLite Database Path
DATABASE_PATH=data/toss_iq.db

# Timezone (Fixed to Asia/Kolkata per specifications)
APP_TIMEZONE=Asia/Kolkata

# Authorized Cricket API Provider (e.g. CricketData.org / CricAPI)
CRICKET_API_KEY=your_cricket_api_key_here
CRICKET_API_BASE_URL=https://api.cricapi.com/v1

# Authorized Odds Data Provider (e.g. The Odds API)
ODDS_API_KEY=your_odds_api_key_here
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# Polling & Refresh Intervals (in seconds)
FIXTURE_POLL_INTERVAL_SECONDS=300
ODDS_POLL_INTERVAL_SECONDS=600

# Statistical Gatekeeper Thresholds
MIN_HISTORICAL_SAMPLE_SIZE=30
STATISTICAL_SIGNIFICANCE_ALPHA=0.05
MAX_DATA_STALENESS_MINUTES=60

# Optional Local Telegram Research Module (Deterministic Local Only)
# Leave blank if not using live MTProto connection
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_AUTHORIZED_CHANNELS=
